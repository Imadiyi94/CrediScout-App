# --- Database (local Postgres 16 via Docker Compose) ---
DATABASE_URL="postgresql://crediscout:crediscout-dev@localhost:5432/crediscout?schema=public"

# --- Better Auth ---
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- File storage selection: local (S3Mock) by default, r2 for Cloudflare ---
STORAGE="local"

# --- Groq AI (CrediScout AI features). Real key ONLY in local .env, never here. ---
GROQ_API_KEY=""

# --- Paystack (disbursement). TEST key in local .env only; live only at go-live. ---
PAYSTACK_SECRET_KEY=""
# R2 is S3-compatible: same client code works locally against MinIO.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="crediscout-docs"

# --- Local R2 stand-in: Adobe S3Mock (Docker Compose, port 9090) ---
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
S3_ENDPOINT_LOCAL="http://localhost:9090"
S3_BUCKET_LOCAL="crediscout-docs"
